# ViNote 环境配置文件
# 复制此文件为 .env 并填写您的配置

# ============================================
# 应用服务配置（可选）
# ============================================
APP_HOST=127.0.0.1
APP_PORT=8999
# 默认仅接受本机 Host；局域网/反向代理使用时添加实际访问域名或 IP（不要填写协议、端口）
# ALLOWED_HOSTS=localhost,127.0.0.1,::1,notes.example.com
# Docker 默认只绑定本机；如显式开放，必须同时配置访问控制与上面的 Host 白名单
# APP_BIND_HOST=127.0.0.1
# 跨域开发地址，逗号分隔；生产构建与 API 同源时无需修改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================
# OpenAI API 配置（可选）
# 留空 OPENAI_API_KEY 仍可启动；依赖大模型的能力会显示降级提示并使用基础结果。
# ============================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# 可选：仅在模型/网关支持 reasoning_effort 时启用；影响笔记整理、翻译、摘要和导图
# 推理模型出现纯推理耗尽输出预算时可尝试 low；默认不发送此参数
# OPENAI_REASONING_EFFORT=low

# ============================================
# ASR 模型配置（可选）
# ============================================
# ASR_PROVIDER 可选值: whisper, funasr, qwen3
# ASR_MODEL 例子:
#   whisper: tiny/base/small/medium/large/large-v3
#   funasr: SenseVoiceSmall
#   qwen3: Qwen3-ASR-0.6B / Qwen3-ASR-1.7B
# ASR_MODEL_SOURCE 可选值: modelscope, huggingface
# ASR_MODEL_DIR 可选值: 本地模型目录（指定后优先生效）
# ASR_DEVICE 可选值: cpu, cuda:0, mps
# ASR_COMPUTE_TYPE 可选值: int8, float16, bfloat16
# ASR_MAX_INPUT_SECONDS: 单个音频切片的最大长度(秒), 默认60
# ASR_MAX_INFERENCE_BATCH_SIZE: 批处理大小, 默认1。显存较小时建议设为1
# 旧版兼容：显式设置后仅在 ASR_PROVIDER=whisper 时覆盖 ASR_MODEL
# WHISPER_MODEL_SIZE=base
ASR_PROVIDER=whisper
# 可选 ASR 依赖由 start.sh/start.bat 和 Docker Compose 按此项自动安装
# 留空时按 provider 选默认模型；切换 provider 时清空旧模型名或填写匹配模型
ASR_MODEL=
ASR_MODEL_SOURCE=huggingface
ASR_MODEL_DIR=
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_MAX_INPUT_SECONDS=60
ASR_MAX_INFERENCE_BATCH_SIZE=1

# ============================================
# 并发配置（可选）
# ============================================
# 批量任务同时处理数。值越大同时跑的任务越多，占用更多内存和API并发
# 建议: 根据内存和API限额调整，一般3-5即可
BATCH_CONCURRENCY=5

# ASR转录并发数。Whisper等ASR模型是CPU/GPU密集型计算
# 模型只加载一次（共享实例），并发不会增加内存占用，但每个转录占1个CPU核
# - 1（默认）: 串行转录，单任务速度最快
# - 2-3: 批量吞吐提升，每个转录稍慢，CPU占用2-3核
# - 5: 5核满载，tiny/base等小模型可承受，large模型慎用
# 参考: tiny模型(~75MB) 5并发≈5核CPU，内存不变；large模型单个就吃满GPU
# 建议: tiny/base模型可设3-5，small/medium设2-3，large/large-v3设1-2
ASR_CONCURRENCY=1

# ============================================
# 启动
# ============================================
# chmod +x start.sh && ./start.sh
